{
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ],
  "redirects": [
    { "source": "/inquire-form", "destination": "/inquiry/", "permanent": true },
    { "source": "/inquire-form/", "destination": "/inquiry/", "permanent": true },
    { "source": "/inquire", "destination": "/inquiry/", "permanent": true }
  ]
}
